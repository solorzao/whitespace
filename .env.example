# Copy to .env.local for local development.
# On Vercel, set these in Project Settings > Environment Variables.

# Anthropic API, for the analysis and follow-up answers.
ANTHROPIC_API_KEY=

# Google Places API (New). Needs a Google Cloud project with billing on.
GOOGLE_PLACES_API_KEY=

# US Census API (ACS 5-year). Free: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Set to 1 to serve sample data from /api/analyze and /api/ask (no API keys needed).
WHITESPACE_MOCK=
