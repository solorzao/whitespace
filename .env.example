# Copy to .env.local for local development.
# On Vercel, set these in Project Settings > Environment Variables.

# Anthropic API, for the analysis and follow-up answers.
ANTHROPIC_API_KEY=

# Google Places API (New). Needs a Google Cloud project with billing on.
GOOGLE_PLACES_API_KEY=

# Set to 1 to allow live (billed) Google Places calls from the app. Leave it unset on Vercel: pins
# near the demo areas use the saved data in data/demo/, and other pins skip ratings and reviews.
# scripts/ingest-demo.ts turns it on for itself.
PLACES_LIVE=

# US Census API (ACS 5-year). Free: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Set to 1 to serve sample data from /api/analyze and /api/ask (no API keys needed).
WHITESPACE_MOCK=

# Optional public satellite tile template: {z}, {x}, {y}.
# Defaults to Esri World Imagery. Do not put private keys in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_IMAGERY_TILE_URL=
